# Local-dev-only SQLite file, used by `prisma migrate dev` when you change
# the schema and need to regenerate migrations/*.sql. The deployed app never
# reads this — on Cloudflare, Prisma talks to D1 through the `DB` binding in
# wrangler.jsonc instead of a connection string.
DATABASE_URL="file:./prisma/dev.db"

# Signs session tokens. Generate with: openssl rand -base64 32
# On Cloudflare this is set with: wrangler secret put AUTH_SECRET
AUTH_SECRET="replace-me"

# Optional. The app sets trustHost, so Auth.js infers its own URL from the
# incoming request and neither AUTH_URL nor NEXTAUTH_URL is required. Set
# AUTH_URL only if you mount the app under a path prefix or sit behind a proxy
# that rewrites the Host header.
# AUTH_URL="https://example.com"
