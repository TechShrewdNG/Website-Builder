// The legacy generator, kept at its default output (node_modules/@prisma/client)
// deliberately: @opennextjs/cloudflare's build has patching logic specifically
// for that default layout to make the wasm query engine loadable in a Worker.
// A custom `output` (or the newer `prisma-client` generator) skips that
// patch entirely and the wasm file ends up missing at runtime.
generator client {
  provider = "prisma-client-js"
}

// D1 is SQLite under the hood, reached through the Prisma D1 driver adapter
// (see src/lib/db.ts) rather than a connection string — there is no
// DATABASE_URL on Cloudflare, only the `DB` binding in wrangler.jsonc.
// DATABASE_URL here is read only by local CLI commands (`prisma migrate dev`
// etc.), pointed at a throwaway local SQLite file — never by the deployed app.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth prisma adapter shape)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  projects Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Builder domain
// ---------------------------------------------------------------------------

model Project {
  id        String   @id @default(cuid())
  name      String
  // Subdomain-ish slug used for the published URL: /s/<slug>/<page path>
  slug      String   @unique
  ownerId   String
  published Boolean  @default(false)

  // Site-wide CSS carried over from an imported template, plus user globals.
  importedCss String?
  customCss   String?
  // Fonts / colour tokens shown in the style panel, as JSON.
  theme       Json?

  // Global sections. Stored on the project rather than duplicated per page,
  // which is what makes an edit propagate everywhere by construction.
  headerTree Json?
  footerTree Json?
  publishedHeaderTree Json?
  publishedFooterTree Json?

  /// Favicon for generated sites, as a data URL.
  faviconData String?

  /// Final public origin of the exported site, e.g. https://example.com.
  /// Canonical URLs and sitemap.xml need absolute URLs, and the host a .zip
  /// ends up on is not knowable from this app.
  siteUrl String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages  Page[]
  assets Asset[]

  @@index([ownerId])
}

model Page {
  id        String  @id @default(cuid())
  projectId String
  title     String
  // "/" for the home page, "/about" etc. Unique within a project.
  path      String
  // The document model: a serialised BuilderNode tree.
  tree      Json
  // Snapshot of `tree` taken at publish time, so editing a live site is safe.
  publishedTree Json?
  sortOrder Int     @default(0)

  // --- SEO -----------------------------------------------------------------
  description String?
  /// Social card image (og:image), as a data URL or absolute URL.
  socialImage String?
  /// Emits noindex, for pages that shouldn't reach search results.
  noIndex     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions PageRevision[]

  @@unique([projectId, path])
  @@index([projectId])
}

model Asset {
  id        String   @id @default(cuid())
  projectId String
  filename  String
  mimeType  String
  size      Int
  // Small images are stored inline as data URLs to keep the MVP single-service.
  data      String  
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A point-in-time snapshot of a page's tree.
///
/// In-session undo dies on reload; this is what makes an edit recoverable
/// tomorrow. Snapshots are taken on publish and on demand, not on every
/// autosave, so the table tracks meaningful states rather than keystrokes.
model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  label     String?
  tree      Json
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}
